# Copy this file to .env and fill in your own values

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/business_analytics

# Or MongoDB Atlas (recommended if Power BI will connect directly):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/business_analytics?retryWrites=true&w=majority

PORT=5000

# Path to the CSV file used by the import script
CSV_PATH=./data/business_analytics_ecommerce_10000.csv
